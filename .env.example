# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=travel_agency

# Server
PORT=3000

# Auth: protects /api/* endpoints (leave unset to disable in dev)
API_KEY=your-strong-api-key-here

# ─── Evolution API (used for ALL WhatsApp: customers + supplier groups) ────────
# EVO_API_URL    : base URL of your Evolution API instance (no trailing slash)
# EVO_API_KEY    : the global API key configured in your Evolution API instance
# EVO_INSTANCE_NAME : the WhatsApp instance name you created in Evolution API
EVO_API_URL=https://your-evolution-instance.com
EVO_API_KEY=your-evolution-api-key-here
EVO_INSTANCE_NAME=agencytravel
# Webhook secret — set this in Evolution API's webhook config, paste same value here
EVO_WEBHOOK_SECRET=your-evolution-webhook-secret-here

# ─── Staff Notifications ───────────────────────────────────────────────────────
# Phone to receive booking alerts (WhatsApp number with country code, e.g. 2348012345678)
STAFF_ALERT_PHONE=2348012345678

# ─── Payment Details (shown to customer after booking) ────────────────────────
PAYMENT_BANK_NAME=First Bank Nigeria
PAYMENT_ACCOUNT_NAME=Travel Agency Ltd
PAYMENT_ACCOUNT_NUMBER=0123456789

# ─── Legacy: WhatsApp Business API (Meta Cloud API) — not used if Evolution is set ──
# WA_API_URL=https://graph.facebook.com/v18.0
# WA_API_TOKEN=your-whatsapp-token-here
# WA_WEBHOOK_SECRET=your-webhook-secret-here
